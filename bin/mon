#!/usr/bin/env bash
configfl="${HOME}/.config/hypr/monitor.conf"
workspfl="${HOME}/.config/hypr/workspaces.conf"

declare -A width
declare -A height

name=""; in_modes=false
while IFS= read -r line; do
	if [[ "$line" != [[:space:]]* && -n "$line" ]]; then
		name="${line#* }" && name="${name% *}" && name="${name% *}"
		in_modes=true

		width["$name"]=0
		height["$name"]=0
		continue
	fi

	[[ "$line" == *"description"* ]] && in_modes=false && continue

	if [[ "$in_modes" == true ]]; then
		line="${line#"${line%%[![:space:]]*}"}"
		line="${line%@*}"

		width["$name"]="${line%x*}"
		height["$name"]="${line#*x}"
	fi
done < <(hyprctl monitors all)

monitor=($(while IFS= read -r line; do
	if [[ "$line" != [[:space:]]* && -n "$line" ]]; then
		name="${line#* }" && name="${name% *}" && name="${name% *}"
		echo "$name"
	fi
done < <(hyprctl monitors all)))

monitor_count="${#monitor[@]}"

workspace() {
	local monitor_name=$1
	local monitor_name2=$2

	truncate -s 0 "$workspfl"
	for ((i=1; i<=10; i++)); do
		echo "workspace = ${i}, monitor:${monitor_name}" >> "$workspfl"
		if [[ $i == 1 ]]; then sed -i '$s/$/, default:true/' "$workspfl"; fi

		if [[ -n "$monitor_name2" ]]; then
			i2=$((i + 10))
			echo "workspace = ${i2}, monitor:${monitor_name2}" >> "$workspfl"
			if [[ $i2 == 11 ]]; then sed -i '$s/$/, default:true/' "$workspfl"; fi
		fi

	done
}

double_monitor() {
	loc=$(( (width["${monitor[1]}"] - width["${monitor[0]}"]) / 2 ))
	echo """
	monitor = ${monitor[1]}, highrr, 0x0, 1
	monitor = ${monitor[0]}, preferred, ${loc}x$((height["${monitor[1]}"])), 1
	""" > "$configfl"
	workspace ${monitor[1]} ${monitor[0]}
}

single_external() {
	echo """
	monitor = ${monitor[1]}, highrr, 0x0, 1
	monitor = ${monitor[0]}, disable
	""" > "$configfl"
	workspace ${monitor[1]}
}

single_internal() {
	echo """
	monitor = ${monitor[1]}, disable
	monitor = ${monitor[0]}, preferred, auto, 1
	""" > "$configfl"
	workspace ${monitor[0]}
}

mirror() {
	echo """
	monitor = ${monitor[1]}, highrr, 0x0, 1
	monitor = ${monitor[0]}, preferred, auto, auto, mirror, ${monitor[1]}
	""" > "$configfl"
	workspace ${monitor[1]}
}

launch() {
	local tmp="/tmp/monitor"
	if [[ ! -f "$tmp" ]]; then
		if [[ "$monitor_count" -gt 1 ]]; then
			single_external
		else
			single_internal
		fi

		echo 1 > "$tmp" && hyprctl reload
	fi
}

case $1 in
	launch) launch ;;
	default) single_internal ;;
	single_external) single_external ;;
	double) double_monitor ;;
	mirror) mirror ;;
	menu) 
		[[ "$monitor_count" -lt 2 ]] && notify-send "You only have 1 monitor" && exit
		double="Double Monitor"
		single="Single External Monitor"
		mirror="Mirror External Monitor"
		default="Single Default Monitor"
		choice=$(echo -e "${double}\n${single}\n${mirror}\n${default}"| rofi -dmenu)
		case $choice in
			$double) double_monitor ;;
			$single) single_external ;;
			$mirror) mirror ;;
			$default) single_internal ;;
			*) exit 1 ;;
		esac
		;;
esac
