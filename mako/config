anchor=top-center
max-history=5
sort=-time

on-button-left=dismiss
on-button-middle=invoke-default-action
on-button-right=dismiss-all
on-notify=exec mpv /usr/share/sounds/freedesktop/stereo/message.oga

font=sans Medium 10
background-color=#101010
text-color=#E8E3E3
width=300
outer-margin=5
margin=10
padding=24,31

border-size=1
border-color=#454545
border-radius=0
progress-color=over #e8e3e3

icons=1
max-icon-size=64
icon-path=/usr/share/icons/Papirus-Dark/
icon-location=left
icon-border-radius=0
markup=1
actions=1
history=0
text-alignment=left
default-timeout=5000
ignore-timeout=1
max-visible=3
layer=overlay
